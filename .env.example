# Radar Zamówień — example environment.
# Copy to .env for local development. Never commit real values.
# `pnpm dev`, `pnpm health` and `pnpm start` load ./.env via Node's built-in
# --env-file-if-exists flag. Variables already set in the real environment take
# precedence over this file. An empty value (e.g. `LOG_LEVEL=`) means "use the
# default". `node dist/main.js` run directly (production, cron) does not read
# .env: export the variables in that environment instead.
# Only variables read by the current code are active; others are listed
# (commented out) together with the PR that introduces them.

# development | test | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL connection URL (required; postgres:// or postgresql://). Use a
# non-superuser role that owns the database (see README, "Baza danych"). For a
# managed database with TLS add e.g. ?sslmode=verify-full. Never printed or logged.
DATABASE_URL=postgres://radar:radar@localhost:5432/radar_dev

# Tests only — read by `pnpm test` / `pnpm check` from the real environment, NOT
# from this file (tests never load .env). A separate, disposable database:
#   TEST_DATABASE_URL=postgres://radar:radar@localhost:5432/radar_test pnpm check
# Without it the PostgreSQL integration tests are skipped (with a notice).

# Public contact of the operator, sent in the crawler User-Agent
# ("RadarZamowien/0.1 (+<contact>)") so source owners can reach us: an e-mail
# address or an https:// URL without credentials (max 200 chars, no spaces).
# Optional for `health`/`migrate`; required by every command that fetches from
# sources (SafeHttpClient refuses to start without it). Use a real, monitored
# contact — never a made-up one.
# CRAWLER_CONTACT=radar@example.com

# --- Introduced in PR-05 (Alert / Daily Digest) ---
# EMAIL_MODE=test   # test = write to local outbox only, smtp = really send
# SMTP_URL=smtp://user:password@smtp.example.com:587
# EMAIL_FROM="Radar Zamówień <radar@example.com>"
