# Radar Zamówień — example environment.
# Copy to .env for local development. Never commit real values.
# `pnpm dev`, `pnpm health` and `pnpm start` load ./.env via Node's built-in
# --env-file-if-exists flag. Variables already set in the real environment take
# precedence over this file. An empty value (e.g. `LOG_LEVEL=`) means "use the
# default". `node dist/main.js` run directly (production, cron) does not read
# .env: export the variables in that environment instead.
# Only variables read by the current code are active; others are listed
# (commented out) together with the PR that introduces them.

# development | test | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL connection URL (required; postgres:// or postgresql://). Use a
# non-superuser role that owns the database (see README, "Baza danych"). For a
# managed database with TLS add e.g. ?sslmode=verify-full. Never printed or logged.
DATABASE_URL=postgres://radar:radar@localhost:5432/radar_dev

# Tests only — read by `pnpm test` / `pnpm check` from the real environment, NOT
# from this file (tests never load .env). A separate, disposable database:
#   TEST_DATABASE_URL=postgres://radar:radar@localhost:5432/radar_test pnpm check
# Without it the PostgreSQL integration tests are skipped (with a notice).

# Public contact of the operator, sent in the crawler User-Agent
# ("RadarZamowien/0.1 (+<contact>)") so source owners can reach us: an e-mail
# address or an https:// URL without credentials (max 200 chars, no spaces).
# Optional for `health`/`migrate`; required by every command that fetches from
# sources (SafeHttpClient refuses to start without it). Use a real, monitored
# contact — never a made-up one.
# CRAWLER_CONTACT=radar@example.com

# --- E-mail for `digest` (PR-05; read by `digest` only) ---
# test (default) = write each e-mail as files to EMAIL_OUTBOX_DIR, nothing is sent;
# smtp = really send. Sending to real recipients needs the project owner's
# confirmation (docs/SECURITY.md §10, §14).
EMAIL_MODE=test

# Test mode only: where the .eml/.json files go (git-ignored, owner-only files;
# they contain the recipient's address). Default ./outbox.
# EMAIL_OUTBOX_DIR=./outbox

# Sender: an address or `Name <address>`. Required for smtp; recipients
# unsubscribe by replying, so use a real, monitored mailbox. Test-mode default:
# Radar Zamówień <radar@example.invalid>.
# EMAIL_FROM=Radar Zamówień <radar@example.invalid>

# Required for smtp. smtps:// = TLS from the start (default port 465);
# smtp:// = STARTTLS, which is required (default port 587). Percent-encode
# special characters in the user and password; no path, query or fragment.
# Never printed or logged. Placeholder values only:
# SMTP_URL=smtps://user:password@smtp.example.invalid:465

# --- Web access (PR-06A; read by `serve`, `digest` and `access:link`) ---
# The address users reach the web server at, through the reverse proxy that
# terminates TLS (https:// required; http:// only for localhost/127.0.0.1/[::1]
# outside production). An origin only: no path, query, credentials. Required by
# `serve` and `access:link`. When set, every `digest` e-mail carries a
# single-use login link and a one-click unsubscribe link (List-Unsubscribe-Post);
# unset = the mailto-only unsubscribe, no web links.
# PUBLIC_BASE_URL=https://radar.example.invalid

# Where `serve` listens (an IP address or localhost; default 127.0.0.1, so only
# the local reverse proxy reaches it) and its port (default 3000). The server
# speaks plain HTTP: never expose it directly to the internet.
# WEB_HOST=127.0.0.1
# WEB_PORT=3000
