# Radar Zamówień — production environment (PR-07B, docs/DEPLOY.md).
# Install as /etc/radar/radar.env, owned root:radar, mode 0640 (the directory
# /etc/radar is root:radar 0750). It holds secrets: never commit the real file.
# Every value below is a placeholder; replace each CHANGE_ME and example.invalid.
#
# Read by `node --env-file=/etc/radar/radar.env` (deploy/systemd and
# deploy/cron). Keep the file valid for Node's --env-file AND systemd's
# EnvironmentFile= alike, so it means the same to both:
#   - one KEY=value per line, no spaces around "=", no `export`;
#   - comments on their own line only: Node cuts a value at an unquoted "#";
#   - no quotes, no "#", no "$", no backslash and no leading or trailing
#     spaces in a value (quoting and escaping differ between the two parsers;
#     neither expands $VARIABLES);
#   - percent-encode such characters inside URLs instead, e.g. in a password:
#     # -> %23, $ -> %24, @ -> %40, : -> %3A, / -> %2F, space -> %20.
# An empty value (KEY=) means "use the default".

NODE_ENV=production
LOG_LEVEL=info

# Non-superuser role owning the database (docs/DEPLOY.md, "PostgreSQL").
DATABASE_URL=postgres://radar:CHANGE_ME@localhost:5432/radar

# Public, monitored contact sent in the crawler's User-Agent (required by ingest).
CRAWLER_CONTACT=radar@example.invalid

# test = e-mails are written to EMAIL_OUTBOX_DIR only; smtp = really sent.
# Switch to smtp only after the owner's confirmation (docs/SECURITY.md §10, §14).
EMAIL_MODE=test
EMAIL_OUTBOX_DIR=/var/lib/radar/outbox
EMAIL_FROM=Radar Zamówień <radar@example.invalid>
# Not used with EMAIL_MODE=test: may stay empty (SMTP_URL=) until the switch to
# smtp; when set, it must be a valid URL.
SMTP_URL=smtps://radar%40example.invalid:CHANGE_ME@smtp.example.invalid:465

# Recipient of `status --notify` alerts.
OPERATOR_EMAIL=operator@example.invalid

# The public origin behind Caddy (= the site address in deploy/caddy/Caddyfile).
PUBLIC_BASE_URL=https://radar.example.invalid
WEB_HOST=127.0.0.1
WEB_PORT=3000

# Where the 05:30 backup writes (deploy/cron/radar); status checks its age.
BACKUP_DIR=/var/backups/radar

# Dead man's switch: pinged by every status run without a problem. A secret
# (the token is in the path): never logged. Empty = no heartbeat. Leave it
# empty until docs/DEPLOY.md point 10 (check set up), then the check's https
# ping URL, e.g. https://hc-ping.example.invalid/<token>.
HEARTBEAT_URL=
